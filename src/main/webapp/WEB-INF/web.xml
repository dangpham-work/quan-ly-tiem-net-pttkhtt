<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Quan Ly Tiem Net</display-name>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Login / Logout -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Khach Hang -->
    <servlet>
        <servlet-name>KhachHangServlet</servlet-name>
        <servlet-class>servlet.KhachHangServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>KhachHangServlet</servlet-name>
        <url-pattern>/khachhang</url-pattern>
    </servlet-mapping>

    <!-- Nhan Vien -->
    <servlet>
        <servlet-name>NhanVienServlet</servlet-name>
        <servlet-class>servlet.NhanVienServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NhanVienServlet</servlet-name>
        <url-pattern>/nhanvien</url-pattern>
    </servlet-mapping>

    <!-- May Tinh -->
    <servlet>
        <servlet-name>MayTinhServlet</servlet-name>
        <servlet-class>servlet.MayTinhServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MayTinhServlet</servlet-name>
        <url-pattern>/maytinh</url-pattern>
    </servlet-mapping>

    <!-- Dich Vu -->
    <servlet>
        <servlet-name>DichVuServlet</servlet-name>
        <servlet-class>servlet.DichVuServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DichVuServlet</servlet-name>
        <url-pattern>/dichvu</url-pattern>
    </servlet-mapping>

    <!-- Goi Dich Vu -->
    <servlet>
        <servlet-name>GoiDichVuServlet</servlet-name>
        <servlet-class>servlet.GoiDichVuServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoiDichVuServlet</servlet-name>
        <url-pattern>/goidichvu</url-pattern>
    </servlet-mapping>

    <!-- Session timeout: 30 minutes -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <error-page>
        <error-code>403</error-code>
        <location>/login.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/login.jsp</location>
    </error-page>

</web-app>
